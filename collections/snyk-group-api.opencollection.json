{
  "opencollection": "1.0.0",
  "info": {
    "name": "Snyk AccessRequests Group API",
    "version": "REST"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Group",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Group (Early Access)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.snyk.io/rest/groups/:group_id",
            "params": [
              {
                "name": "version",
                "value": "2026-03-25",
                "type": "query",
                "description": "The requested version of the endpoint to process the request"
              },
              {
                "name": "group_id",
                "value": "",
                "type": "path",
                "description": "Unique identifier of the group."
              }
            ]
          },
          "docs": "Get a group\n\n#### Required permissions\n\n- `View Groups (group.read)`"
        }
      ]
    }
  ],
  "bundled": true
}