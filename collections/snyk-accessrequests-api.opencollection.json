{
  "opencollection": "1.0.0",
  "info": {
    "name": "Snyk AccessRequests API",
    "version": "REST"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "AccessRequests",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get access requests (Early Access)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.snyk.io/rest/self/access_requests",
            "params": [
              {
                "name": "version",
                "value": "2026-03-25",
                "type": "query",
                "description": "The requested version of the endpoint to process the request"
              },
              {
                "name": "starting_after",
                "value": "v1.eyJpZCI6IjEwMDAifQo=",
                "type": "query",
                "description": "Return the page of results immediately after this cursor"
              },
              {
                "name": "ending_before",
                "value": "v1.eyJpZCI6IjExMDAifQo=",
                "type": "query",
                "description": "Return the page of results immediately before this cursor"
              },
              {
                "name": "limit",
                "value": "10",
                "type": "query",
                "description": "Number of results to return per page"
              },
              {
                "name": "org_id",
                "value": "",
                "type": "query",
                "description": "The IDs of the org to filter by"
              }
            ]
          },
          "docs": "Get a list of user's access requests"
        }
      ]
    }
  ],
  "bundled": true
}